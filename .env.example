# Salin menjadi .env lalu isi. Berkas .env TIDAK boleh masuk Git.
# Buat nilai acak, misalnya: python -c "import secrets; print(secrets.token_urlsafe(48))"

MYSQL_PASSWORD=ganti-dengan-kata-sandi-acak
MYSQL_ROOT_PASSWORD=ganti-dengan-kata-sandi-acak-lain
JWT_RAHASIA=ganti-dengan-string-acak-minimal-32-karakter

# Alamat publik aplikasi (dipakai untuk CORS)
URL_PUBLIK=http://localhost:8080
PORT_WEB=8080

# Akun admin pertama. Kosongkan ADMIN_PASSWORD agar dibuat acak dan dicetak sekali oleh:
#   docker compose exec api python -m scripts.seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Mode AI: "tiruan" sampai model pengenal bunga dipasang
AI_MODE=tiruan

# Tag image dari GHCR (mis. sha-1a2b3c4 atau v1.0.0); "latest" = cabang main terbaru
TAG=latest
