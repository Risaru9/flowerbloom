# Salin menjadi .env lalu sesuaikan. Berkas .env tidak boleh masuk Git.

LINGKUNGAN=pengembangan            # pengembangan | produksi (produksi mewajibkan JWT_RAHASIA kuat)

# Basis data. SQLite cukup untuk pengembangan cepat; gunakan MySQL untuk yang sebenarnya (lihat docker-compose.yml).
DATABASE_URL=sqlite:///./flowerbloom.db
# DATABASE_URL=mysql+pymysql://flowerbloom:flowerbloom-dev@127.0.0.1:3306/flowerbloom?charset=utf8mb4

# Uji penuh di MySQL (opsional; nama basis data WAJIB berakhiran _uji karena dikosongkan tiap tes). Lihat README.
# UJI_DATABASE_URL=mysql+pymysql://flowerbloom:flowerbloom-dev@127.0.0.1:3306/flowerbloom_uji?charset=utf8mb4

# Autentikasi
JWT_RAHASIA=ganti-dengan-string-acak-minimal-32-karakter
JWT_BERLAKU_MENIT=480
TAUTAN_BERKAS_BERLAKU_MENIT=10

# Penyimpanan berkas (folder publik/ disajikan di /media, folder privat/ hanya lewat tautan bertanda tangan)
DIREKTORI_BERKAS=./penyimpanan
UKURAN_MAKS_UNGGAH_MB=8

# Alamat frontend yang boleh memanggil API (JSON)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Pengenalan jenis bunga otomatis. "nonaktif" (bawaan) = admin memilih jenis; warna SELALU dibaca otomatis.
# "tiruan" = jenis ditebak ACAK, hanya untuk mencoba alur saat pengembangan (ditolak bila LINGKUNGAN=produksi).
AI_MODE=nonaktif
# AI_TIRUAN_KELAS=74                # paksa AI tiruan selalu menjawab kelas ini (74 = mawar) untuk uji frontend
AMBANG_KEYAKINAN=0.60
AMBANG_KECOCOKAN_WARNA=20

# Penjadwal pesanan kedaluwarsa
PENJADWAL_AKTIF=true
PENJADWAL_INTERVAL_DETIK=60

# Akun admin awal (dipakai `python -m scripts.seed`). Bila ADMIN_PASSWORD kosong, dibuat acak dan dicetak sekali.
ADMIN_NAMA=Admin FlowerBloom
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
